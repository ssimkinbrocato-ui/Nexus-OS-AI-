name: Nexus Self-Test

on: [push, pull_request]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v3
    
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.10'
    
    - name: Install dependencies
      run: |
        pip install pytest pytest-cov
    
    - name: Run NyxLang tests
      run: |
        python -m pytest nyxlang/tests/ -v
    
    - name: Test crash recovery
      run: |
        python -c "
import sys
sys.path.insert(0, 'nyxlang/core')
from crash_recovery import NexusCheckpoint, install_crash_handlers
cp = NexusCheckpoint()
install_crash_handlers(cp)
print('Crash handlers installed successfully')
"
    
    - name: Sandbox self-patch test
      run: |
        python nexus_healer/self_patch.py