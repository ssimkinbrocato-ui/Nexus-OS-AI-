def test_native():
    """Test the native assembly module"""
    print("[NATIVE] Testing x86_64 JIT...")
    
    asm = NativeAssembler()
    
    # Test simple add function
    add_func = asm.compile_add(0, 0)
    result = add_func(40, 2)
    print(f"[NATIVE] 40 + 2 = {result}")
    assert result == 42, "Native add failed!"
    
    # Test tensor ops
    tensors = NativeTensorOps()
    a = [[1, 2], [3, 4]]
    b = [[5, 6], [7, 8]]
    result = tensors.dot(a, b)
    print(f"[NATIVE] Matrix dot: {result}")
    
    print("[NATIVE] All tests passed!")

if __name__ == "__main__":
    test_native()