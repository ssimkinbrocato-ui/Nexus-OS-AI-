"""
NyxLang Native Assembly Module
Direct x86_64 code generation via mmap executable memory
HolyC-inspired: 'God said let there be code, and it was executable'
"""

import mmap
import ctypes
import os
import struct

class NativeAssembler:
    """
    Assembles x86_64 machine code and executes it natively.
    No interpreter overhead. Direct metal.
    """
    
    def __init__(self):
        self.code_buffer = None
        self.labels = {}
        self.fixups = []
    
    def _create_executable_buffer(self, size=4096):
        """Allocate RWX memory for JIT compilation"""
        return mmap.mmap(
            -1, 
            size, 
            prot=mmap.PROT_READ | mmap.PROT_WRITE | mmap.PROT_EXEC
        )
    
    def emit_bytes(self, *bytes_seq):
        """Emit raw machine code bytes"""
        for b in bytes_seq:
            self.code_buffer.write(struct.pack('B', b))
    
    def emit_mov_reg_imm64(self, reg, imm):
        """MOV reg64, imm64 (full 64-bit immediate)"""
        # REX.W + B8+rd io
        rex = 0x48 | ((reg >> 3) & 1)  # REX.W + R bit
        opcode = 0xB8 + (reg & 7)
        self.emit_bytes(rex, opcode)
        self.code_buffer.write(struct.pack('<Q', imm))
    
    def emit_mov_rax_imm64(self, imm):
        """MOV rax, imm64"""
        self.emit_bytes(0x48, 0xB8)
        self.code_buffer.write(struct.pack('<Q', imm))
    
    def emit_ret(self):
        """RET"""
        self.emit_bytes(0xC3)
    
    def emit_syscall(self):
        """SYSCALL - invoke Linux kernel"""
        self.emit_bytes(0x0F, 0x05)
    
    def emit_push(self, reg):
        """PUSH reg64"""
        self.emit_bytes(0x50 + (reg & 7))
    
    def emit_pop(self, reg):
        """POP reg64"""
        self.emit_bytes(0x58 + (reg & 7))
    
    def compile_add(self, a, b):
        """
        Compile: int64_t add(int64_t a, int64_t b) { return a + b; }
        Returns callable function pointer
        """
        self.code_buffer = self._create_executable_buffer()
        
        # Function prologue
        self.emit_push(6)  # Save r12 (callee-saved)
        
        # mov rax, rdi (first arg)
        self.emit_bytes(0x48, 0x89, 0xF8)
        
        # add rax, rsi (add second arg)
        self.emit_bytes(0x48, 0x01, 0xF0)
        
        # Function epilogue
        self.emit_pop(6)   # Restore r12
        self.emit_ret()
        
        # Create callable function
        self.code_buffer.seek(0)
        buffer_addr = ctypes.addressof(ctypes.c_char.from_buffer(self.code_buffer))
        
        # Define function type: int64_t (*)(int64_t, int64_t)
        func_type = ctypes.CFUNCTYPE(ctypes.c_int64, ctypes.c_int64, ctypes.c_int64)
        func = func_type(buffer_addr)
        
        return func
    
    def compile_tensor_dot_stub(self):
        """
        Stub for tensor dot product - calls into optimized C via syscall
        """
        self.code_buffer = self._create_executable_buffer()
        
        # Save registers
        for r in range(6, 12):  # r12-r15 are callee-saved
            self.emit_push(r)
        
        # mov rax, 1 (sys_write for debug)
        self.emit_mov_rax_imm64(1)
        
        # mov rdi, 1 (stdout)
        self.emit_bytes(0x48, 0xC7, 0xC7, 0x01, 0x00, 0x00, 0x00)
        
        # mov rsi, msg (pointer to message)
        msg = b"Tensor op native\x00"
        # This is simplified - real implementation would allocate string in data section
        
        # mov rdx, len
        self.emit_bytes(0x48, 0xC7, 0xC2, len(msg), 0x00, 0x00, 0x00)
        
        # syscall
        self.emit_syscall()
        
        # Restore registers
        for r in range(11, 5, -1):
            self.emit_pop(r)
        
        self.emit_ret()
        
        self.code_buffer.seek(0)
        buffer_addr = ctypes.addressof(ctypes.c_char.from_buffer(self.code_buffer))
        
        func_type = ctypes.CFUNCTYPE(ctypes.c_int64)
        return func_type(buffer_addr)
    
    def __del__(self):
        """Cleanup executable memory"""
        if self.code_buffer:
            self.code_buffer.close()


class NativeTensorOps:
    """
    Native tensor operations using SIMD when available
    """
    
    def __init__(self):
        self.asm = NativeAssembler()
        self.cache = {}  # JIT cache
    
    def add_1d(self, a, b):
        """Element-wise addition of 1D tensors"""
        key = f"add_1d_{len(a)}"
        if key not in self.cache:
            self.cache[key] = self._compile_add_1d(len(a))
        
        return self.cache[key](a, b)
    
    def _compile_add_1d(self, size):
        """JIT compile vectorized addition"""
        # Simplified: returns Python callable for now
        # Full implementation would generate AVX2 code
        def vectorized_add(a, b):
            return [x + y for x, y in zip(a, b)]
        return vectorized_add
    
    def dot(self, a, b):
        """Matrix multiplication - delegates to native or numpy"""
        # Check if we have a cached native implementation
        shape_key = f"{len(a)}x{len(a[0]) if a else 0}_{len(b)}x{len(b[0]) if b else 0}"
        
        if shape_key in self.cache:
            return self.cache[shape_key](a, b)
        
        # Fall back to Python implementation, cache for next time
        result = self._python_dot(a, b)
        
        # Trigger background JIT compilation
        # self._jit_compile_dot(shape_key, a, b)
        
        return result
    
    def _python_dot(self, a, b):
        """Pure Python matrix multiplication"""
        return [[sum(x * y for x, y in zip(row, col)) 
                 for col in zip(*b)] 
                for row in a]


